# === DATABASE (Neon) ===
# Lấy từ Neon dashboard -> Connection Details -> Connection string
DATABASE_URL=postgresql://neondb_owner:password@ep-xxx.neon.tech/neondb?sslmode=require

# === JWT ===
# Dùng: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-use-strong-random-string
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=change-me-use-different-strong-random-string
JWT_REFRESH_EXPIRATION=7d

# === CORS ===
CORS_ORIGIN=https://your-app.onrender.com

# === RATE LIMITING ===
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# === APP ===
PORT=3000
NODE_ENV=production
